<?xml version="1.0" encoding="utf-8"?>
<!--
  The app is hard-linked to SocioBird (go.sociobird.app) and only talks to it
  over HTTPS, so cleartext traffic is not permitted anywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
